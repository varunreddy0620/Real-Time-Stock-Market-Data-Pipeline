# --- Pipeline ---
APP_ENV=development
LOG_LEVEL=INFO
TICKERS=AAPL,MSFT,GOOGL
POLL_INTERVAL_SECONDS=5
OHLCV_INTERVAL=5m
LOOKBACK_PERIOD=1d
DATA_SOURCE=auto
LIVE_RETRY_COOLDOWN_SECONDS=600
INDICATOR_MAX_GAP_SECONDS=86400

# --- Redis Streams ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM=stock:ohlcv
REDIS_STREAM_MAXLEN=1000000
REDIS_CONSUMER_GROUP=pipeline
REDIS_CONSUMER_NAME=worker-1
REDIS_PENDING_IDLE_MS=60000
REDIS_MAX_DELIVERY_ATTEMPTS=3
REDIS_DEAD_LETTER_STREAM=stock:ohlcv:dead-letter

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=market
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=raw-ohlcv
MINIO_SECURE=false

# --- Alerts (optional) ---
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=alerts@example.com
ALERT_TO_EMAIL=you@example.com
ENABLE_EMAIL_ALERTS=false
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# --- Dashboard ---
DASHBOARD_DEFAULT_TICKER=AAPL
